(defpoll time
 :interval "1s"
 :initial "0:00"
 "date +%H:%M")

(defpoll full_date
 :interval "1s"
 :initial "0:00"
 "date +'%b %d'")

(defpoll mpd_song
 :interval "0.5s"
 :initial "nil"
 "MPD_PORT=40220 mpc current")

(defpoll mpd_play_pause
 :interval "0.5s"
 :initial ""
 "MPD_PORT=40220 mpc status | awk 'NR==2 {if ($1 == \"[playing]\") print \"\"; else if ($1 == \"[paused]\") print \"\"; else print \"󰓛\"}'")

(defpoll pinger
 :interval "10s"
 :initial "󰲛"
 "ping -c 1 -W 1 1.1.1.1 2>/dev/null | awk -F '/' 'END {print $5}'")

(defvar time_hover false)
(defvar ctrl_open false)

(deflisten cava_file
 :initial ""
 "cava -p ~/.config/eww/config.cava | ~/.config/eww/cava")

(defwindow bar
 :monitor 0
 :geometry (geometry :x "0%"
                     :y "0%"
                     :width "100%"
                     :height "40px"
                     :anchor "top center")
 :stacking "fg"
 :exclusive true
 :focusable false
 (bar_layout))

; main bar
(defwidget bar_layout []
 (box :class "bar-class" :orientation "h"
  (box :class "left-container" :halign "start" (left))
  (box :class "center-container" :halign "center" (center))
  (box :class "right-container" :halign "end" (right))))

; right modules
(defwidget cpu_module []
 (box :class "cpu_module" "${round(EWW_CPU.avg, 0)}%"))

(defwidget memory_module []
 (box :class "memory_module" "${round(EWW_RAM.used_mem_perc, 0)}%"))

(defwidget time_module []
 (eventbox
  :onhover "${EWW_CMD} update time_hover=true"
  :onhoverlost "${EWW_CMD} update time_hover=false"
  :cursor "pointer"
  (box :class "time_container" :orientation "h" :space-evenly false
   (revealer
    :transition "slideright"
    :reveal time_hover
    :duration "250ms"
    (box :class "date_part" "${full_date}"))
  (box :class "time_module"
   time))))

(defwidget pinger_module []
 (box :class "pinger_module" "${round(pinger, 1)}ms"))

(defwidget ctrl_module []
 (box :class "ctrl_container" :orientation "h" :space-evenly false
  (revealer
   :transition "slideright"
   :reveal ctrl_open
   :duration "250ms"
   (box :class "ctrl_content" :space-evenly false
    (button :class "ctrl_button" :onclick "poweroff" "")
    (button :class "ctrl_button" :onclick "reboot" "")
    (button :class "ctrl_button" :onclick "pkill -u $USER" "󰈆")))
  (eventbox
   :cursor "pointer"
   :onclick "${EWW_CMD} update ctrl_open=${!ctrl_open}"
   (box :class "ctrl_module"
    "${ctrl_open ? '' : ''}"))))


; left modules
(defwidget mpd_module []
 (box :class "mpd_module" "${mpd_play_pause} ${mpd_song} "))

; center modules
(defwidget cava_module []
 (box :class "cava_module"
  (image
   :path cava_file
   :image-width 300
   :image-height 22)))

(defwidget left []
 (box :class "modules_left" :space-evenly false :spacing 0
  (mpd_module)))

(defwidget center []
 (box :class "modules_center" :space-evenly false :spacing 0
  (cava_module)))

(defwidget right []
 (box :class "modules_right" :space-evenly false :spacing 0
  (ctrl_module)
  (pinger_module)
  (cpu_module)
  (memory_module)
  (time_module)))

(defwidget blank_spacer []
 (box :class "blank_spacer"))
